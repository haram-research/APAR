{
  "name": "apar",
  "description": "Automated Provisional Answer Review",
  "author": "HARAM PARK",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron:dev": "electron . --development",
    "electron:build": "vite build && electron-builder --config.directories.output=release"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "clsx": "^2.1.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.haram.apar",
    "productName": "APAR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-app/**/*",
      "main.cjs",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042"
    },
    "publish": {
      "provider": "github",
      "owner": "haram-research",
      "repo": "APAR"
    }
  }
}
